+#[derive(Clone)]
+struct AllocUnit {
+    name: String,
+    elem: String,
+    count: Expr,
+    bytes: Expr,
+    guard_frees: Vec<String>,
+}
+
+fn malloc_call(value: &Expr) -> Option<(&str, &Expr)> {
+    let call = match value {
+        Expr::Cast(_, inner) => inner.as_ref(),
+        v => v,
+    };
+    let Expr::FuncCall(f, args) = call else { return None };
+    match (StdlibFn::from_name(f), args.as_slice()) {
+        (Some(StdlibFn::Malloc), [bytes]) => Some((f.as_str(), bytes)),
+        _ => None,
+    }
+}
+
+fn freed_var(s: &Statement) -> Option<&str> {
+    match s {
+        Statement::Expr(Expr::FuncCall(f, args)) if matches!(StdlibFn::from_name(f), Some(StdlibFn::Free)) => {
+            match args.as_slice() {
+                [Expr::Var(x)] => Some(x.as_str()),
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+fn alloc_unit(alloc: &Statement, guard: &Statement) -> Option<AllocUnit> {
+    let Statement::Assign { target: Expr::Var(x), value, compound: false } = alloc else { return None };
+    let (_, bytes) = malloc_call(value)?;
+    let sizeof_type = |e: &Expr| match e {
+        Expr::FuncCall(f, a) if matches!(StdlibFn::from_name(f), Some(StdlibFn::Sizeof)) => match a.as_slice() {
+            [Expr::Var(t)] => Some(t.clone()),
+            _ => None,
+        },
+        _ => None,
+    };
+    let Expr::BinOp(l, BinOp::Mul, r) = bytes else { return None };
+    let (count, elem) = match (sizeof_type(r), sizeof_type(l)) {
+        (Some(t), _) => (l.as_ref().clone(), t),
+        (None, Some(t)) => (r.as_ref().clone(), t),
+        (None, None) => return None,
+    };
+    let Statement::If { condition: Expr::Not(tested), then_body, else_body, .. } = guard else { return None };
+    if !matches!(tested.as_ref(), Expr::Var(v) if v == x)
+        || !else_body.is_empty()
+        || !matches!(then_body.last(), Some(Statement::Return { .. }))
+    {
+        return None;
+    }
+    let mut guard_frees = Vec::new();
+    let mut other_free = false;
+    for_each_nested(then_body, &mut |s| {
+        if let Some(y) = freed_var(s) {
+            guard_frees.push(y.to_string());
+        } else {
+            crate::streaming::walk_stmt_own_exprs(s, &mut |e| {
+                crate::streaming::walk_expr(e, &mut |sub| {
+                    other_free |= matches!(sub, Expr::FuncCall(f, _) if matches!(StdlibFn::from_name(f), Some(StdlibFn::Free)));
+                });
+            });
+        }
+    });
+    if other_free {
+        return None;
+    }
+    Some(AllocUnit { name: x.clone(), elem, count, bytes: bytes.clone(), guard_frees })
+}
+
+fn for_each_nested(body: &[Statement], f: &mut dyn FnMut(&Statement)) {
+    for s in body {
+        f(s);
+        for nested in crate::streaming::nested_bodies(s).0 {
+            for_each_nested(nested, f);
+        }
+    }
+}
+
+fn collect_alloc_runs(body: &[Statement], runs: &mut Vec<Vec<AllocUnit>>) {
+    let mut j = 0;
+    while j < body.len() {
+        let Some(first) = body.get(j + 1).and_then(|g| alloc_unit(&body[j], g)) else {
+            for nested in crate::streaming::nested_bodies(&body[j]).0 {
+                collect_alloc_runs(nested, runs);
+            }
+            j += 1;
+            continue;
+        };
+        let mut run = vec![first];
+        j += 2;
+        while let Some(next) = body.get(j + 1).and_then(|g| alloc_unit(&body[j], g)) {
+            if next.elem != run[0].elem {
+                break;
+            }
+            run.push(next);
+            j += 2;
+        }
+        if run.len() >= 2 {
+            runs.push(run);
+        }
+    }
+}
+
+fn run_is_coalescible(body: &[Statement], run: &[AllocUnit]) -> bool {
+    let names: Vec<&str> = run.iter().map(|u| u.name.as_str()).collect();
+    let distinct: BTreeSet<&str> = names.iter().copied().collect();
+    if distinct.len() != names.len() {
+        return false;
+    }
+    let reads_run = |e: &Expr| names.iter().any(|n| expr_mentions(e, n));
+    for (i, u) in run.iter().enumerate() {
+        if !u.guard_frees.iter().all(|y| names[..i].contains(&y.as_str())) {
+            return false;
+        }
+        let pure = !crate::streaming::expr_effect(&u.count, &|f| {
+            f.ends_with("_lookback")
+                || matches!(StdlibFn::from_name(f), Some(StdlibFn::Sizeof))
+                || crate::backends::builtins::MathFn::from_name(f).is_some()
+        });
+        if !pure || reads_run(&u.count) {
+            return false;
+        }
+    }
+    single_assignment(body, &names) && frees_in_groups(body, &names)
+}
+
+fn single_assignment(body: &[Statement], names: &[&str]) -> bool {
+    let is_run_var = |e: &Expr| matches!(e, Expr::Var(v) if names.contains(&v.as_str()));
+    let mut assigns = 0usize;
+    let mut ok = true;
+    for_each_nested(body, &mut |s| {
+        match s {
+            Statement::Assign { target, .. } if is_run_var(target) => assigns += 1,
+            Statement::VarDecl { name, init: Some(_), .. } if names.contains(&name.as_str()) => ok = false,
+            Statement::For { var, .. } if names.contains(&var.as_str()) => ok = false,
+            _ => {}
+        }
+        crate::streaming::walk_stmt_own_exprs(s, &mut |e| {
+            crate::streaming::walk_expr(e, &mut |sub| match sub {
+                Expr::AddressOf(x)
+                | Expr::PostIncrement(x)
+                | Expr::PostDecrement(x)
+                | Expr::PreIncrement(x)
+                | Expr::PreDecrement(x)
+                    if is_run_var(x) =>
+                {
+                    ok = false;
+                }
+                _ => {}
+            });
+        });
+    });
+    ok && assigns == names.len()
+}
+
+fn frees_in_groups(body: &[Statement], names: &[&str]) -> bool {
+    let is_unit_alloc = |s: &Statement| {
+        matches!(s, Statement::Assign { target: Expr::Var(x), value, compound: false }
+            if names.contains(&x.as_str()) && malloc_call(value).is_some())
+    };
+    let mut skip_guard = false;
+    for (p, s) in body.iter().enumerate() {
+        if std::mem::take(&mut skip_guard) {
+            continue;
+        }
+        if is_unit_alloc(s) {
+            skip_guard = true;
+            continue;
+        }
+        if freed_var(s).is_some_and(|y| names.contains(&y)) {
+            let start = (0..p).rev().take_while(|&q| freed_var(&body[q]).is_some()).last().unwrap_or(p);
+            let end = (p..body.len()).take_while(|&q| freed_var(&body[q]).is_some()).last().unwrap_or(p);
+            let group: Vec<&str> =
+                body[start..=end].iter().filter_map(freed_var).filter(|y| names.contains(y)).collect();
+            let each_once = group.len() == names.len() && names.iter().all(|n| group.contains(n));
+            let read_after = body[end + 1..].iter().any(|t| names.iter().any(|n| stmt_mentions(t, n)));
+            if !each_once || read_after {
+                return false;
+            }
+            continue;
+        }
+        let mut stray_free = false;
+        crate::streaming::walk_stmt_own_exprs(s, &mut |e| {
+            crate::streaming::walk_expr(e, &mut |sub| {
+                if let Expr::FuncCall(f, args) = sub {
+                    stray_free |= matches!(StdlibFn::from_name(f), Some(StdlibFn::Free))
+                        && args.iter().any(|a| names.iter().any(|n| expr_mentions(a, n)));
+                }
+            });
+        });
+        if stray_free {
+            return false;
+        }
+        if !crate::streaming::nested_bodies(s).0.into_iter().all(|b| frees_in_groups(b, names)) {
+            return false;
+        }
+    }
+    true
+}
+
+fn apply_alloc_runs(body: &[Statement], runs: &[Vec<AllocUnit>]) -> Vec<Statement> {
+    let position = |x: &str| {
+        runs.iter().find_map(|run| run.iter().position(|u| u.name == x).map(|i| (run.as_slice(), i)))
+    };
+    let mut out = Vec::with_capacity(body.len());
+    let mut empty_guard = false;
+    for s in body {
+        if std::mem::take(&mut empty_guard) {
+            out.push(Statement::Block { body: Vec::new() });
+            continue;
+        }
+        if let Statement::Assign { target: Expr::Var(x), value, compound: false } = s {
+            if let (Some((run, i)), Some((f, _))) = (position(x), malloc_call(value)) {
+                let value = if i == 0 {
+                    let total = run[1..].iter().fold(run[0].bytes.clone(), |sum, u| {
+                        Expr::BinOp(Box::new(sum), BinOp::Add, Box::new(u.bytes.clone()))
+                    });
+                    let call = Expr::FuncCall(f.to_string(), vec![total]);
+                    match value {
+                        Expr::Cast(t, _) => Expr::Cast(t.clone(), Box::new(call)),
+                        _ => call,
+                    }
+                } else {
+                    empty_guard = true;
+                    Expr::BinOp(
+                        Box::new(Expr::Var(run[i - 1].name.clone())),
+                        BinOp::Add,
+                        Box::new(run[i - 1].count.clone()),
+                    )
+                };
+                out.push(Statement::Assign { target: Expr::Var(x.clone()), value, compound: false });
+                continue;
+            }
+        }
+        if freed_var(s).and_then(position).is_some_and(|(_, i)| i > 0) {
+            out.push(Statement::Block { body: Vec::new() });
+            continue;
+        }
+        out.push(recurse(s, &|b| apply_alloc_runs(b, runs)));
+    }
+    out
+}
