+/// C only: a run of consecutive same-typed `x = malloc(E * sizeof(T)); if( !x )
+/// { ..; return ..; }` becomes one allocation sliced at the running offsets, and
+/// every free group keeps only the head's `free`.
+///
+/// Glibc returns blocks above its trim threshold to the kernel on `free`, so
+/// several series-length blocks freed together are page-faulted in again on
+/// every call; one block of the summed size is not.
+///
+/// A run is rewritten whole or not at all. What makes dropping the other frees
+/// and guards sound, and must stay checked: each local is assigned only by its
+/// own allocation; every other `free` of a run local sits in a group of
+/// consecutive frees naming each local once, with no later read in that block;
+/// a guard frees only earlier locals of its run; each `E` is pure and reads no
+/// run local, so its value at the head equals its value at its own slice.
+///
+/// `None` when no run qualifies.
+pub(crate) fn coalesce_allocations(body: &[Statement]) -> Option<Vec<Statement>> {
+    let mut runs = Vec::new();
+    collect_alloc_runs(body, &mut runs);
+    runs.retain(|run| run_is_coalescible(body, run));
