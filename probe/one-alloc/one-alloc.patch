+/// `func` with its batch bodies' scratch allocation runs coalesced, and the
+/// stream source pinned to the uncoalesced body: the stream analysis needs the
+/// separate allocations, and its Open coalesces at render time instead.
+fn coalesced_allocations(func: &FuncDef) -> std::borrow::Cow<'_, FuncDef> {
+    use super::ir_cleanup::coalesce_allocations;
+    let body = coalesce_allocations(&func.body);
+    let private_body = coalesce_allocations(&func.private_body);
+    if body.is_none() && private_body.is_none() {
+        return std::borrow::Cow::Borrowed(func);
+    }
+    let mut out = func.clone();
+    out.resolved_stream_body = Some(func.stream_source().to_vec());
+    out.body = body.unwrap_or_else(|| func.body.clone());
+    out.private_body = private_body.unwrap_or_else(|| func.private_body.clone());
+    std::borrow::Cow::Owned(out)
+}
