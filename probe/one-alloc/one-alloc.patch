+/// The local holding the heap block `series` lives in: itself, or the head of
+/// the coalesced allocation it is a slice of.
+fn heap_block_of<'s>(open: &'s str, series: &'s str) -> &'s str {
+    let slice = format!(" {series} = ");
+    let Some(at) = open.find(&slice) else { return series };
+    let rhs = &open[at + slice.len()..];
+    match rhs.split_once(" + ") {
+        Some((base, _)) if !base.contains('(') => heap_block_of(open, base),
+        _ => series,
+    }
+}
