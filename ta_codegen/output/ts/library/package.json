{
  "name": "ta-lib",
  "version": "0.8.4",
  "description": "Technical analysis library: 200+ indicators (SMA, EMA, RSI, MACD, Bollinger Bands, ATR, Stochastic, candlestick patterns). The official TypeScript port of TA-Lib, verified against the C reference.",
  "keywords": [
    "ta-lib",
    "talib",
    "technical-analysis",
    "technical-indicators",
    "indicators",
    "candlestick-patterns",
    "streaming",
    "finance",
    "trading"
  ],
  "homepage": "https://ta-lib.org",
  "type": "module",
  "sideEffects": [
    "./dist/engine/node.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/engine/index.d.ts",
      "node": {
        "types": "./dist/engine/node.d.ts",
        "default": "./dist/engine/node.js"
      },
      "bun": {
        "types": "./dist/engine/node.d.ts",
        "default": "./dist/engine/node.js"
      },
      "deno": {
        "types": "./dist/engine/node.d.ts",
        "default": "./dist/engine/node.js"
      },
      "default": "./dist/engine/index.js"
    },
    "./js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/engine/index.d.ts",
  "typesVersions": {
    "*": {
      "js": [
        "./dist/index.d.ts"
      ],
      "metadata": [
        "./dist/metadata/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TA-Lib/ta-lib.git",
    "directory": "ta_codegen/output/ts/library"
  },
  "license": "BSD-3-Clause"
}
