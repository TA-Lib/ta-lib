<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shipped TA-Lib C# library. Hand-written and committed; ta_codegen never
       opens this file. Generated sources (the enums and the per-indicator
       `partial class Core` files) live under src/; the hand-written
       scaffolding (Core.cs, RetCode.cs, OutRange.cs, ...) sits at this level.

       net10.0 (LTS, supported to Nov 2028) is the single target. Not
       netstandard: the generated indicators call Math.FusedMultiplyAdd (the
       cross-language FMA bit-parity contract, PR #96), which no netstandard
       version has, and a software FMA substitute would break bit-parity —
       the one thing this port must not do.

       net8.0 was dropped rather than multi-targeted. The date that matters is
       PUBLICATION, not today: landing on main is not a release (Java and Rust
       sit on main unpublished too), and by the time this is on NuGet .NET 8
       will be roughly a year past its 10 Nov 2026 end of support. Nothing here
       needs an API newer than .NET Core 3.0, so an older TFM would have bought
       reach and nothing else — and a TFM no gate executes is a promise nobody
       checked. Re-adding one is a one-line change if a real consumer asks.

       TreatWarningsAsErrors + GenerateDocumentationFile makes CS1591 (missing
       XML doc on a public member) an error — the C# analog of the Java
       -Xdoclint gate. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>TALib</RootNamespace>
    <AssemblyName>TALib</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The metadata catalogue is a generated static table with delegate
         thunks, deliberately not reflection. This makes that a checked fact
         rather than a claim: IL2026/IL3050 (trim/AOT-unsafe) become warnings
         here, and TreatWarningsAsErrors turns them into build failures. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <!-- Written by scripts/sync.py from the VERSION file, like the pom and the
         Cargo manifests. Never hand-edit it. -->
    <Version>0.8.2</Version>
    <Authors>Mario Fortier</Authors>
    <!-- Claims a floor, not a count: a published version is immutable, and
         scripts/pre-release-checks.py verifies the corpus still meets it. -->
    <Description>Technical analysis library: 200+ indicators (SMA, EMA, RSI, MACD, Bollinger Bands, ATR, Stochastic, candlestick patterns) - the official .NET port of TA-Lib, verified against the C reference.</Description>
    <PackageTags>ta-lib technical-analysis finance trading indicators candlestick</PackageTags>
    <PackageProjectUrl>https://ta-lib.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TA-Lib/ta-lib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- The file, not the SPDX expression: BSD-3 clause 2 requires the text to
         travel with a binary redistribution, and an expression ships none. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <!-- No PackageId yet. The default is AssemblyName, an id the project does
         not own, and pushing to an id someone else owns answers 403 with text
         that blames the API key. -->
    <!-- test/ is a SIBLING project (test/TALib.Test.csproj) that compiles these
         same library sources itself. Without this exclusion the SDK's default
         **/*.cs glob pulls the suites — and their obj/ AssemblyInfo — into the
         shipped library, which then fails with CS0579 duplicate-attribute and
         would ship test code inside TALib.dll. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);test/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repo root LICENSE in place, the way the pom reads it for the jar.
         PackagePath empty puts it at the archive root, where
         PackageLicenseFile resolves it. -->
    <None Include="../../../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
