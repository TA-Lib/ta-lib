<?xml version="1.0"?>
<project name="ta-lib" basedir="." default="build">
	<property name="debug" value="true"/>
	<property name="dir.src" value="src/"/>
	<property name="file.jar" value="ta-lib.jar"/>
	<property name="dir.classes" value="classes"/>
	<path id="classpath.base">
		<pathelement location="${dir.src}"/>
	</path>
	<!-- The tests are plain main() classes: junit is not in the tree, the old
	     junit target had been dead for years, and its suite registered a single
	     class that the API break deleted (it would have passed vacuously). The
	     same classes run from `ta_codegen build --backend=java`, so they gate
	     every build; this target is the manual equivalent. -->
	<target name="test" depends="build">
		<echo message="Running ${ant.project.name} tests"/>
		<java classname="io.github.talib.test.CoreApiTest"
		      classpath="${dir.classes}" failonerror="true"/>
		<java classname="io.github.talib.test.BatchApiTest"
		      classpath="${dir.classes}" failonerror="true"/>
		<java classname="io.github.talib.test.SMathOverflowTest"
		      classpath="${dir.classes}" failonerror="true"/>
		<java classname="io.github.talib.test.StreamSmokeTest"
		      classpath="${dir.classes}" failonerror="true"/>
	</target>
	<target name="build" description="Build ta-lib.">
		<echo message="Building project ${ant.project.name}"/>
		<mkdir dir="${dir.classes}"/>
		<copy todir="${dir.classes}" includeEmptyDirs="false">
			<fileset dir="${dir.src}" excludes="**/*.java"/>
		</copy>
		<!-- Minimum JDK 17 (LTS): the public API returns `record OutRange`,
		     which needs Java 16+, and the generated Core.java uses
		     java.lang.Math.fma (the FMA numerical contract, PR #96) from Java 9.
		     Pinning release=17 makes an older-JDK build fail with a clear
		     unsupported-release error instead of a confusing missing-symbol one. -->
		<javac srcdir="${dir.src}" destdir="${dir.classes}" debug="${debug}" release="17">
			<classpath refid="classpath.base"/>
		</javac>
		<delete file="${file.jar}"/>
		<jar destfile="${file.jar}" basedir="${dir.classes}"/>
	</target>
	<target name="clean" description="clean up all generated files.">
		<echo message="Cleaning up project ${ant.project.name}"/>
		<delete dir="${dir.classes}"/>
		<delete file="${file.jar}"/>
	</target>
</project>
